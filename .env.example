# Required for real teacher/student workflows. Set secrets through Vercel.
DATABASE_URL=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Comma-separated approved Clerk user IDs. Empty means no teacher is authorized.
TEACHER_USER_IDS=

# Optional model override; never expose Gateway credentials to the client.
AI_MODEL=openai/gpt-5.4-mini
AI_QUESTIONS_PER_HOUR=30
AI_DESIGN_PER_HOUR=40
# Local Gateway authentication comes from `vercel env pull`, not a committed token.
# Private student evidence storage. Provision Vercel Blob; never expose this token to the client.
BLOB_READ_WRITE_TOKEN=

# Multimodal evidence AI. The teacher selects a registered provider in the school-approval UI.
# Vercel AI Gateway uses Vercel OIDC in production; local auth comes from `vercel env pull`.
EVIDENCE_AI_PROVIDER=disabled
EVIDENCE_OCR_MODEL=openai/gpt-5.4-mini
EVIDENCE_TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe
EVIDENCE_CHAT_MODEL=openai/gpt-5.4-mini
EVIDENCE_SCORING_MODEL=openai/gpt-5.4-mini
EVIDENCE_AI_HOURLY_LIMIT=60
