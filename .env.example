# Required for real teacher/student workflows. Set secrets through Vercel.
DATABASE_URL=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Comma-separated approved Clerk user IDs. Empty means no teacher is authorized.
TEACHER_USER_IDS=

# Optional model override; never expose Gateway credentials to the client.
AI_MODEL=openai/gpt-5.6-luna
AI_QUESTIONS_PER_HOUR=30
# Local Gateway authentication comes from `vercel env pull`, not a committed token.
